{
  "name": "@phasewire/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "default": "./dist/launcher.js"
    },
    "./core-facade": {
      "types": "./dist/core-facade.d.ts",
      "default": "./dist/core-facade.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts --project-root ../..",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@phasewire/core": "0.1.0",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
