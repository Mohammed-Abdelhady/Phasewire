{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phasewire.dev/schemas/config.schema.json",
  "title": "Phasewire project config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "defaultTemplateId", "requiredValidations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "defaultTemplateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "requiredValidations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "defaultHarness": { "type": "string", "minLength": 1 },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "scope"],
      "properties": {
        "hosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scope": { "enum": ["project", "user"] },
        "installedAt": { "type": "string", "minLength": 1 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autoOpenOnMutate", "autoOpenOnStatusWithId"],
      "properties": {
        "autoOpenOnMutate": { "type": "boolean" },
        "autoOpenOnStatusWithId": { "type": "boolean" }
      }
    }
  }
}
