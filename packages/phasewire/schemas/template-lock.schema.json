{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phasewire.dev/schemas/template-lock.schema.json",
  "title": "Phasewire template lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "templates": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "integrity", "layer"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "layer": { "enum": ["builtin", "user", "project"] }
        }
      }
    }
  }
}
