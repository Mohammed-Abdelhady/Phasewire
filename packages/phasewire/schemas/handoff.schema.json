{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phasewire.dev/schemas/handoff.schema.json",
  "title": "Phasewire neutral handoff packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffId",
    "workflowId",
    "createdAt",
    "createdBy",
    "heads",
    "logicalClock",
    "status",
    "currentPhase",
    "cycle",
    "readOnly",
    "artifactPaths",
    "openBlockingFindingIds",
    "requiredValidations",
    "passedValidations",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "handoffId": { "type": "string", "pattern": "^handoff_[a-f0-9]{64}$" },
    "workflowId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["user", "harness", "system"] },
        "harness": { "type": "string" },
        "displayName": { "type": "string" }
      }
    },
    "intendedFor": { "type": "string" },
    "note": { "type": "string" },
    "heads": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evt_[a-f0-9]{64}$" }
    },
    "logicalClock": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["planning", "executing", "reviewing", "remediating", "deployment-ready", "conflicted"] },
    "currentPhase": { "enum": ["plan", "execute", "review", "remediation"] },
    "cycle": { "type": "integer", "minimum": 0 },
    "readOnly": { "type": "boolean" },
    "artifactPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "openBlockingFindingIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "requiredValidations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "passedValidations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
